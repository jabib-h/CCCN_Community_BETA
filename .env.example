# CCCN Hub (BETA) — variables de entorno. Copiar a .env (gitignored) y completar en local;
# en Vercel van en Project Settings → Environment Variables, NUNCA hardcodeadas ni en el
# repo (Panorama Legal, Paso 1). Ver docs/DEPLOY_VERCEL.md.

# ---- Entorno ----
HUB_ENV=dev                                  # dev | beta | production — "dev" es el único modo permisivo
HUB_BASE_URL=http://localhost:8700           # beta: https://<proyecto>.vercel.app (o dominio propio)

# ---- Base de datos ----
# Vacío en dev → SQLite en data/hub_dev.db. Obligatorio fuera de dev.
HUB_DATABASE_URL=
# beta: cadena "Connection pooling" (modo transaction, puerto 6543) del proyecto Supabase
#   postgresql+psycopg://postgres.[ref]:PASSWORD@aws-0-[region].pooler.supabase.com:6543/postgres
# El pooler es obligatorio: cada invocación serverless abre su propia conexión.

# ---- Secretos ----
# Vacíos en dev → se generan una vez en data/state/. Obligatorios fuera de dev (Vercel
# no persiste disco entre invocaciones: si faltan, cada cold start invalidaría los JWT
# ya emitidos).
HUB_JWT_SECRET=
HUB_SESSION_SECRET=
HUB_JWT_TTL_MINUTES=60

# ---- OAuth (vacío = proveedor deshabilitado) ----
# Google:    https://console.cloud.google.com/apis/credentials
#            redirect: HUB_BASE_URL/api/v1/auth/oauth/google/callback
HUB_GOOGLE_CLIENT_ID=
HUB_GOOGLE_CLIENT_SECRET=
# Microsoft Entra: App registration
#            redirect: HUB_BASE_URL/api/v1/auth/oauth/microsoft/callback
HUB_MS_CLIENT_ID=
HUB_MS_CLIENT_SECRET=
HUB_MS_TENANT=common

# ---- Servicios externos ----
HUB_OVERDRIVE_URL=https://centrocultural.overdrive.com/

# ---- Contacto ----
HUB_MAIL_FROM=hub@centrocultural.cr
HUB_CONTACTO_DATOS=datos@centrocultural.cr   # canal ARCO publicado en las páginas legales

# ---- Límites de tasa (por IP, ventana de 60 s) ----
HUB_RATE_LIMIT_PUBLIC=60
HUB_RATE_LIMIT_AUTH=10

# ---- Reglas de circulación de biblioteca ----
HUB_PRESTAMO_DIAS=14
HUB_PRESTAMO_MAX_ACTIVOS=3
HUB_MULTA_DIARIA_CRC=200

# ---- Retención ----
HUB_AUDIT_RETENTION_DAYS=1095                # 3 años
